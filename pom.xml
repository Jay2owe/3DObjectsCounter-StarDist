	<groupId>io.github.jay2owe</groupId>
	<artifactId>3D_Objects_Counter_StarDist</artifactId>
	<!--
	  Versioning policy: see VERSIONING.md.
	  First digit = new feature set.
	  Second digit = major rework or large optimization.
	  Third digit = bug fix or small tweak/optimization.
	-->
	<version>0.1.0-SNAPSHOT</version>

	<name>3D Objects Counter - StarDist</name>
	<description>Fiji/ImageJ plugin that counts and measures 3D objects in a Z-stack by running StarDist on each slice and linking the per-slice detections through Z with TrackMate, with per-object 3D measurements, morphology filters, object maps and folder batch processing.</description>
	<url>https://github.com/Jay2owe/3DObjectsCounter-StarDist</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>UK Dementia Research Institute at Imperial College London</name>
		<url>https://ukdri.ac.uk/centres/imperial</url>
	</organization>
	<!--
